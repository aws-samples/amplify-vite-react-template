    <meta property="og:description" content="Get a fast HOA insurance review from ProtectMyHOA — master policies, D&O, HO-6 and more." />
    <meta property="og:url" content="https://www.protectmyhoa.com/quote" />
    <link rel="canonical" href="https://www.protectmyhoa.com/quote" />

    <Analytics />
  </head>
  <body>
    <div id="quote-root">
      <QuoteApp client:only="react" />
    </div>
  </body>
</html>
